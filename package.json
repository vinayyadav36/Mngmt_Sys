{
  "name": "trustchain-ems",
  "version": "1.0.0",
  "description": "Decentralized Evidence Management System on Ethereum with IPFS storage",
  "main": "server.js",
  "scripts": {
    "chain": "ganache --port 7545 --chain.chainId 1337 --chain.networkId 1337 --wallet.deterministic",
    "compile": "truffle compile",
    "migrate": "truffle migrate --network development",
    "migrate:reset": "truffle migrate --reset --network development",
    "approve:user": "truffle exec scripts/approve-user.js --network development",
    "serve": "node server.js",
    "start": "node server.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "ganache": "^7.9.2",
    "solc": "^0.8.13",
    "truffle": "^5.11.5"
  },
  "engines": {
    "node": ">=20"
  }
}
